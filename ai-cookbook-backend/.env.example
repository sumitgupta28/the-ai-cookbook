APP_NAME=ai-backend-service
APP_ENV=local
APP_PROFILE=local
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:3000
APP_MAX_UPLOAD_MB=50

# Anthropic release-1 scope
AI_CHAT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_TEMPERATURE=0.7

# PostgreSQL / pgvector
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ragdb
DB_USER=postgres
DB_PASSWORD=postgres

# RAG defaults aligned with Java config
RAG_MODE=soft
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.0
CHUNKING_TINY_THRESHOLD=600
CHUNKING_SMALL_THRESHOLD=3000
EMBEDDING_DIMENSIONS=384
